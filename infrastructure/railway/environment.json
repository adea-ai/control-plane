{
  "schemaVersion": 1,
  "provider": "railway",
  "profile": "cloud",
  "applicationEnvironment": "managed-cloud",
  "deploymentMetadata": {
    "commit": "RAILWAY_GIT_COMMIT_SHA",
    "serviceVersion": "RAILWAY_DEPLOYMENT_ID",
    "explicitOverrides": ["COMMIT_SHA", "SERVICE_VERSION"]
  },
  "database": {
    "provider": "railway-postgres",
    "project": "control-plane",
    "runtimeVariable": "DATABASE_URL",
    "migrationVariable": "DATABASE_MIGRATION_URL",
    "administrationVariable": "DATABASE_ADMIN_URL",
    "runtimeRole": "control_plane_app",
    "migrationRole": "control_plane_migrator",
    "administrationRole": "control_plane_admin",
    "targetContract": "production-database.json"
  },
  "environments": {
    "production": {
      "railwayEnvironment": "production",
      "applicationEnvironment": "production",
      "sourceBranch": "main",
      "database": {
        "provider": "railway-postgres",
        "targetContract": "production-database.json"
      }
    }
  },
  "shared": [
    {
      "name": "CONTROL_PLANE_SERVICE_AUTH_ISSUER",
      "classification": "configuration",
      "purpose": "exact trusted Agent HQ service-credential issuer"
    },
    {
      "name": "CONTROL_PLANE_SERVICE_AUTH_TRUSTED_KEYS",
      "classification": "configuration",
      "purpose": "bounded JSON key set of trusted Agent HQ Ed25519 public keys"
    },
    {
      "name": "CONTROL_PLANE_SERVICE_AUTH_REVOKED_CREDENTIAL_IDS",
      "classification": "configuration",
      "purpose": "bounded JSON set of emergency-revoked service credential identifiers"
    }
  ],
  "services": {
    "control-api": [
      "DATABASE_URL",
      "CONTROL_PLANE_SECRET_ENCRYPTION_KEY",
      "CONTROL_PLANE_SERVICE_AUTH_ISSUER",
      "CONTROL_PLANE_SERVICE_AUTH_TRUSTED_KEYS",
      "CONTROL_PLANE_SERVICE_AUTH_REVOKED_CREDENTIAL_IDS",
      "R2_ENDPOINT",
      "R2_BUCKET",
      "R2_REGION",
      "R2_ACCESS_KEY_ID",
      "R2_SECRET_ACCESS_KEY",
      "RESTATE_INGRESS_URL"
    ],
    "workflow-worker": [
      "DATABASE_URL",
      "CONTROL_PLANE_SECRET_ENCRYPTION_KEY",
      "RESTATE_REQUEST_IDENTITY_PUBLIC_KEY",
      "R2_ENDPOINT",
      "R2_BUCKET",
      "R2_REGION",
      "R2_ACCESS_KEY_ID",
      "R2_SECRET_ACCESS_KEY",
      "CONTROL_PLANE_CLOUD_RUNTIME"
    ]
  },
  "objectStore": {
    "provider": "cloudflare-r2",
    "bucket": "ctrl-plane",
    "region": "auto",
    "endpointVariable": "R2_ENDPOINT",
    "accessKeyVariable": "R2_ACCESS_KEY_ID",
    "secretKeyVariable": "R2_SECRET_ACCESS_KEY",
    "cors": "not configured; no browser-direct upload path is part of the M9 baseline",
    "lifecycle": "abort incomplete multipart uploads after 7 days",
    "environmentSeparation": {
      "ephemeral": "Optional isolated qualification must use its own credentials and unique per-run prefix; never production credentials.",
      "requirement": "No persistent staging environment exists. Production stays unprefixed; cross-environment access must remain denied."
    }
  },
  "restate": {
    "contract": "restate.json",
    "ingressVariable": "RESTATE_INGRESS_URL",
    "requestIdentityPublicKeyVariable": "RESTATE_REQUEST_IDENTITY_PUBLIC_KEY",
    "requestIdentityPrivateKeyFileVariable": "RESTATE_WORKER__INVOKER__REQUEST_IDENTITY_PRIVATE_KEY_PEM_FILE"
  },
  "secrets": {
    "valuesCommitted": false,
    "dynamicCredentialProvider": "PostgreSQL-backed credential_secrets; encryption key remains a Railway secret"
  }
}
