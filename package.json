{
  "name": "adea",
  "version": "0.87.0",
  "private": true,
  "license": "Apache-2.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "build:cloudflare": "bun scripts/build-cloudflare.mjs",
    "dev": "turbo run dev --filter=@adea-ai/web --env-mode=loose",
    "fmt": "oxfmt .",
    "format:check": "oxfmt --check .",
    "format:write": "oxfmt --write .",
    "lint": "turbo run lint && oxlint --deny-warnings",
    "test": "bun run test:unit",
    "test:unit": "turbo run test && bun run test:coverage",
    "test:coverage": "bun test packages/auth/tests/unit packages/db/tests/unit packages/types/tests/execution-location.test.ts packages/types/tests/migration-snapshot.test.ts scripts/*.test.ts --coverage",
    "test:bundle:dev-view": "bun run --cwd apps/web build && node scripts/check-dev-view-bundle.mjs",
    "test:integration": "bun scripts/test-integration.mjs",
    "typecheck": "turbo run typecheck",
    "db:health": "node scripts/database-health.mjs",
    "evidence:manifest": "node scripts/evidence-manifest.mjs",
    "relay:purge": "bun run --cwd packages/types build && bun scripts/purge-relay-ciphertext.ts",
    "test:e2e": "bun scripts/e2e-setup.mjs && bun scripts/e2e-playwright.mjs",
    "test:e2e:dev-view-terminal": "bun scripts/e2e-setup.mjs && PLAYWRIGHT_HEADLESS=1 playwright test --config=playwright.config.ts apps/web/e2e/dev-view-terminal.spec.ts apps/web/e2e/dev-view-runtime-terminal.spec.ts",
    "test:e2e:visual": "playwright test --config=playwright.config.ts apps/web/e2e/conventional-workspace.spec.ts",
    "test:e2e:visual:chat": "playwright test --config=playwright.config.ts apps/web/e2e/chat-view-visual.spec.ts",
    "test:e2e:chat": "playwright test --config=playwright.config.ts apps/web/e2e/chat-view.spec.ts",
    "test:packaged": "bun scripts/test-dev-runtime-packaged.mjs",
    "test:packaged:owner-journey": "bun apps/desktop/shell/scripts/packaged-owner-journey.ts",
    "test:packaged:vault": "bun scripts/test-m10-33-packaged-vault.mjs",
    "test:security:dev-runtime": "bun scripts/test-dev-runtime-security.mjs",
    "test:performance:dev-runtime": "bun scripts/test-dev-runtime-performance.mjs",
    "test:performance:web": "bun scripts/measure-web-performance.mjs",
    "test:soak:dev-runtime": "bun scripts/test-dev-runtime-soak.mjs",
    "test:terminal-endurance": "bun scripts/test-dev-runtime-terminal-endurance.mjs",
    "test:perf": "bun run test:performance:dev-runtime",
    "test:security": "bun test scripts/desktop-auth-boundary.test.ts scripts/desktop-ipc-boundary.test.ts scripts/desktop-origin-boundary.test.ts",
    "test:soak": "bun run test:soak:dev-runtime",
    "test:scale:dev-runtime": "bun scripts/test-dev-runtime-scale.mjs",
    "test:scale": "bun run test:scale:dev-runtime",
    "test:browser:desktop-client": "bunx playwright install --with-deps chromium && bun apps/desktop/scripts/client.mjs && node scripts/check-desktop-client-browser.mjs"
  },
  "devDependencies": {
    "@adea-ai/ui": "0.122.3",
    "@playwright/test": "^1.63.0",
    "@shadcn/lint": "^0.2.0",
    "@tailwindcss/postcss": "^4.3.3",
    "axe-core": "^4.13.0",
    "bun-types": "^1.4.2",
    "code-foundry": "1.44.3",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "release-please": "17.11.2",
    "tailwindcss": "^4.3.3",
    "turbo": "^2.11.7",
    "typescript": "^7.0.2",
    "typescript6": "npm:typescript@^6.0.3"
  },
  "overrides": {
    "@adea-ai/themes": "0.9.10",
    "@capacitor/android": "8.5.1",
    "@capacitor/cli": "8.5.1",
    "@capacitor/core": "8.5.1",
    "@capacitor/ios": "8.5.1",
    "brace-expansion": "5.0.12",
    "esbuild": "^0.25.0",
    "seroval": "^1.6.8",
    "seroval-plugins": "^1.6.8",
    "sharp": "0.35.5",
    "undici": "8.11.2",
    "uuid": "^14.0.0"
  },
  "engines": {
    "node": "24.21.0"
  },
  "packageManager": "bun@1.4.0"
}
