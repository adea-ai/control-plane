{
  "name": "@control-plane/workspace",
  "version": "1.92.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "context:admin": "bun scripts/context-provider-admin.mjs",
    "admission:admin": "bun scripts/admission-rollout-admin.mjs",
    "type-check": "turbo run build openapi:check && bun run db:check && bun run compatibility:check && bun run requirements:check && bun run architecture:check && bun run infra:typecheck",
    "compatibility:check": "bun --cwd=packages/runtime-sdk run compatibility:check",
    "architecture:check": "bun scripts/architecture-audit.mjs",
    "architecture:write": "bun scripts/architecture-audit.mjs --write",
    "architecture:refresh": "bun scripts/architecture-audit.mjs --refresh",
    "requirements:check": "bun scripts/requirements-ledger.mjs --check-issues",
    "requirements:atomic:write": "bun scripts/atomic-clause-ledger.mjs --write",
    "requirements:crosswalk:write": "bun scripts/atomic-clause-ledger.mjs --crosswalk --write",
    "requirements:write": "bun scripts/requirements-ledger.mjs --write",
    "requirements:refresh": "bun scripts/requirements-ledger.mjs --refresh-issues",
    "lint": "turbo run lint && oxlint --deny-warnings tests && bun run check:boundaries && bun run check:canonical-ordering",
    "openapi:check": "turbo run openapi:check",
    "test": "bun run build && bun run --parallel 'test:group:*'",
    "test:group:unit": "bun scripts/run-bun-test-group.mjs unit --coverage --timeout 30000",
    "test:group:e2e": "bun scripts/run-bun-test-group.mjs e2e --timeout 30000",
    "test:group:smoke": "bun scripts/run-bun-test-group.mjs smoke --timeout 30000",
    "test:unit": "bun run build && bun scripts/run-bun-test-group.mjs unit --coverage --timeout 30000",
    "test:isolation-matrix": "bun scripts/run-m9-isolation-matrix.mjs",
    "test:secret-canaries": "bun scripts/run-m9-secret-canaries.mjs",
    "test:integration": "bun scripts/run-integration-tests.mjs",
    "test:recovery": "bun scripts/run-postgres-restore-drill.mjs",
    "test:recovery-matrix": "bun scripts/run-m9-recovery-matrix.mjs",
    "test:load": "bun scripts/run-m9-load.mjs",
    "test:m9-acceptance": "bun run build && bun test tests/m9-production-hardening.test.mjs && bun run security:scan && bun run test:load",
    "test:m10-conformance": "bun run build && bun test tests/m10-portability-conformance.test.mjs && bun run --filter @control-plane/profile-portability test",
    "test:m10-operability": "bun run build && bun test tests/m10-operability.test.mjs && bun run --filter @control-plane/deployment test",
    "test:m11-standalone": "bun run build && bun test tests/m3-durable-execution.test.mjs tests/m4-runtime-fabric.test.mjs tests/m5-runtime-gateway.test.mjs tests/m6-runtime-adapters.test.mjs tests/m7-tools-models-sandboxes.test.mjs tests/m8-multi-agent-orchestration.test.mjs tests/m10-portability-conformance.test.mjs tests/m11-standalone-e2e.test.mjs tests/m11-local-native-terminal-usage.test.mjs --timeout 60000 && bun run --filter @control-plane/context test && bun run --filter @control-plane/cortana-context-adapter test && bun run --filter @control-plane/remote-control-relay test && bun run --filter @control-plane/profile-portability test && bun run --filter @control-plane/deployment test",
    "certify:m9-cloud": "bun run build && bun scripts/certify-m9-cloud.mjs",
    "checkpoint": "bun scripts/control-plane-checkpoint.mjs",
    "test:e2e": "bun run build && bun scripts/run-bun-test-group.mjs e2e --timeout 30000",
    "test:smoke": "bun run build && bun scripts/run-bun-test-group.mjs smoke --timeout 30000",
    "test:foundation": "bun run test && bun run test:integration",
    "test:acceptance": "bun scripts/run-foundation-acceptance.mjs",
    "test:m3-acceptance": "bun test tests/m3-durable-execution.test.mjs",
    "test:m4-acceptance": "bun --cwd=apps/control-api run build && bun test tests/m4-runtime-fabric.test.mjs",
    "test:m5-acceptance": "bun run build && bun test tests/m5-runtime-gateway.test.mjs",
    "test:m6-acceptance": "bun run build && bun test tests/m6-runtime-adapters.test.mjs",
    "test:m7-acceptance": "bun run build && bun test tests/m7-tools-models-sandboxes.test.mjs",
    "test:m8-acceptance": "bun run build && bun test tests/m8-multi-agent-orchestration.test.mjs",
    "test:coverage": "bun run test:unit",
    "test:shard": "bun run build && bun scripts/run-bun-test-group.mjs unit --timeout 30000",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "check:boundaries": "turbo boundaries",
    "check:canonical-ordering": "bun scripts/check-locale-compare.mjs",
    "security:scan": "bun scripts/scan-secrets.mjs",
    "containers:build": "docker buildx bake -f infrastructure/containers/docker-bake.hcl",
    "containers:print": "docker buildx bake -f infrastructure/containers/docker-bake.hcl --print",
    "infra:typecheck": "tsc --ignoreConfig --noEmit --strict --module NodeNext --moduleResolution NodeNext --target ES2024 --types node .railway/railway.ts",
    "infra:validate": "bun scripts/validate-railway.mjs",
    "railway:production-plan": "bun scripts/railway-production-plan.mjs",
    "railway:standby": "bun scripts/railway-standby.mjs",
    "db:check": "bun --cwd=packages/database run db:check",
    "db:up": "docker compose up -d postgres",
    "db:stop": "docker compose stop postgres"
  },
  "devDependencies": {
    "@control-plane/acp-adapter": "workspace:*",
    "@control-plane/config": "workspace:*",
    "@control-plane/context": "workspace:*",
    "@control-plane/contracts": "workspace:*",
    "@control-plane/control-api": "workspace:*",
    "@control-plane/credential-vault": "workspace:*",
    "@control-plane/database": "workspace:*",
    "@control-plane/deployment": "workspace:*",
    "@control-plane/domain": "workspace:*",
    "@control-plane/events": "workspace:*",
    "@control-plane/execution-plan": "workspace:*",
    "@control-plane/langgraph-adapter": "workspace:*",
    "@control-plane/local-control-plane": "workspace:*",
    "@control-plane/managed-pi-adapter": "workspace:*",
    "@control-plane/model-gateway": "workspace:*",
    "@control-plane/object-store": "workspace:*",
    "@control-plane/orchestration": "workspace:*",
    "@control-plane/pi-durable-adapter": "workspace:*",
    "@control-plane/policy": "workspace:*",
    "@control-plane/production-readiness": "workspace:*",
    "@control-plane/profile-adapters": "workspace:*",
    "@control-plane/profile-portability": "workspace:*",
    "@control-plane/runtime-gateway": "workspace:*",
    "@control-plane/runtime-gateway-protocol": "workspace:*",
    "@control-plane/runtime-sdk": "workspace:*",
    "@control-plane/sandbox": "workspace:*",
    "@control-plane/sdk": "workspace:*",
    "@control-plane/secrets": "workspace:*",
    "@control-plane/sqlite-persistence": "workspace:*",
    "@control-plane/tool-execution": "workspace:*",
    "@control-plane/usage-ledger": "workspace:*",
    "@control-plane/workflow-runtime": "workspace:*",
    "@control-plane/workflow-worker": "workspace:*",
    "@earendil-works/pi-ai": "1.1.0",
    "@langchain/langgraph": "1.4.20",
    "@types/node": "^26.6.4",
    "acorn": "8.19.0",
    "code-foundry": "1.45.2",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.86.0",
    "railway": "3.13.0",
    "reflect-metadata": "0.2.2",
    "turbo": "^2.11.7",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "esbuild": "0.28.2",
    "fastify": "5.12.5",
    "sharp": "0.35.5",
    "undici": "8.11.2"
  },
  "engines": {
    "bun": ">=1.4.0 <2",
    "node": "24.21.0"
  },
  "packageManager": "bun@1.4.2",
  "patchedDependencies": {
    "postgres@3.4.9": "patches/postgres@3.4.9.patch"
  }
}
