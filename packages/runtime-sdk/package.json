{
  "name": "@control-plane/runtime-sdk",
  "version": "1.5.2",
  "description": "SDK for building Control Plane runtimes: adapters, capabilities, conformance, discovery, eligibility, health, sessions, transport, and routing.",
  "keywords": [
    "runtime",
    "sdk",
    "agents",
    "conformance",
    "adapter"
  ],
  "files": [
    "dist"
  ],
  "type": "module",
  "browser": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "node": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "compatibility:check": "bun scripts/compatibility.mjs --check",
    "compatibility:generate": "bun scripts/compatibility.mjs",
    "lint": "oxlint src",
    "test": "bun test src"
  },
  "dependencies": {
    "@control-plane/contracts": "workspace:*",
    "zod": "4.5.4"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adea-ai/control-plane.git",
    "directory": "packages/runtime-sdk"
  },
  "bugs": "https://github.com/adea-ai/control-plane/issues",
  "homepage": "https://github.com/adea-ai/control-plane#readme"
}
