{
  "name": "@control-plane/sdk",
  "version": "1.6.1",
  "description": "Typed client for the Control Plane API with transport, response mapping, OpenAPI baseline, and testing helpers.",
  "keywords": [
    "agents",
    "api",
    "client",
    "sdk",
    "typed"
  ],
  "homepage": "https://github.com/adea-ai/control-plane#readme",
  "bugs": "https://github.com/adea-ai/control-plane/issues",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adea-ai/control-plane.git",
    "directory": "packages/control-sdk"
  },
  "files": [
    "dist",
    "openapi"
  ],
  "type": "module",
  "browser": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "node": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "node": "./dist/testing.js",
      "default": "./dist/testing.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "oxlint src",
    "openapi:check": "bun scripts/openapi.mjs --check",
    "openapi:generate": "bun scripts/openapi.mjs --write",
    "openapi:initialize-baseline": "bun scripts/openapi.mjs --initialize-baseline",
    "test": "bun test src/*.test.mjs"
  },
  "dependencies": {
    "@control-plane/contracts": "workspace:^"
  },
  "devDependencies": {
    "zod": "4.5.4"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
