{
  "name": "@control-plane/testing",
  "version": "1.1.2",
  "private": true,
  "files": [
    "dist"
  ],
  "type": "module",
  "browser": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "node": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./postgres": {
      "types": "./dist/postgres.d.ts",
      "node": "./dist/postgres.js",
      "default": "./dist/postgres.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "oxlint src",
    "test": "bun test src/index.test.mjs",
    "test:integration": "bun test --timeout 30000 src/postgres.integration.test.mjs"
  },
  "dependencies": {
    "@control-plane/config": "workspace:*",
    "@control-plane/database": "workspace:*"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
