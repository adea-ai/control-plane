{
  "name": "@control-plane/telemetry",
  "version": "1.3.0",
  "description": "Fail-open observability toolkit: structured logging, secret redaction, trace-context propagation, deterministic sampling, and pluggable OpenTelemetry, Sentry, and LangSmith adapters.",
  "keywords": [
    "langsmith",
    "logging",
    "observability",
    "opentelemetry",
    "redaction",
    "sentry",
    "telemetry",
    "tracing"
  ],
  "bugs": "https://github.com/adea-ai/control-plane/issues",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adea-ai/control-plane.git",
    "directory": "packages/telemetry"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "browser": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "node": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./opentelemetry": {
      "types": "./dist/opentelemetry.d.ts",
      "node": "./dist/opentelemetry.js",
      "default": "./dist/opentelemetry.js"
    },
    "./sentry": {
      "types": "./dist/sentry.d.ts",
      "node": "./dist/sentry.js",
      "default": "./dist/sentry.js"
    },
    "./catalog": {
      "types": "./dist/catalog.d.ts",
      "node": "./dist/catalog.js",
      "default": "./dist/catalog.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "oxlint src",
    "test": "bun test src/index.test.mjs"
  },
  "devDependencies": {
    "@opentelemetry/api": "1.9.1",
    "@sentry/node": "10.73.0"
  },
  "peerDependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@sentry/node": "^10.73.0"
  },
  "peerDependenciesMeta": {
    "@opentelemetry/api": {
      "optional": true
    },
    "@sentry/node": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24 <25"
  }
}
