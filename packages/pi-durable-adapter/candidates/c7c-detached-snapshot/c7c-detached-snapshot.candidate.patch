--- /dev/null
+++ b/dist/storage/sqlite/open-registry.js
@@ -0,0 +1,39 @@
+import { statSync } from "node:fs";
+/**
+ * CANDIDATE C7c (not consumable). In-process registry of file-backed read-write SQLite opens, keyed by device and inode so a
+ * hard link or another spelling of the same file is the same entry. It sees only opens made through this module instance in this
+ * process. It says nothing about another process, another copy of this package, or a crashed owner.
+ */
+const open = new Map();
+const keys = new WeakMap();
+function identity(path) {
+    const stat = statSync(path);
+    return `${stat.dev}:${stat.ino}`;
+}
+export function registerWriterOpen(path, owner) {
+    if (path === ":memory:")
+        return;
+    const key = identity(path);
+    keys.set(owner, key);
+    let owners = open.get(key);
+    if (owners === undefined) {
+        owners = new Set();
+        open.set(key, owners);
+    }
+    owners.add(owner);
+}
+export function releaseWriterOpen(owner) {
+    const key = keys.get(owner);
+    if (key === undefined)
+        return;
+    keys.delete(owner);
+    const owners = open.get(key);
+    if (owners === undefined)
+        return;
+    owners.delete(owner);
+    if (owners.size === 0)
+        open.delete(key);
+}
+export function isOpenForWrite(stat) {
+    return open.has(`${stat.dev}:${stat.ino}`);
+}
