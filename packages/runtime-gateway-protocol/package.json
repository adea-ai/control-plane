{
  "name": "@control-plane/runtime-gateway-protocol",
  "version": "1.4.1",
  "description": "Versioned wire protocol between the Control Plane and external runtimes: schemas, emulator, fixtures, and authentication.",
  "keywords": [
    "agents",
    "gateway",
    "protocol",
    "runtime",
    "schemas",
    "zod"
  ],
  "homepage": "https://github.com/adea-ai/control-plane#readme",
  "bugs": "https://github.com/adea-ai/control-plane/issues",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adea-ai/control-plane.git",
    "directory": "packages/runtime-gateway-protocol"
  },
  "files": [
    "dist",
    "fixtures",
    "schema"
  ],
  "type": "module",
  "browser": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "node": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./fixtures": "./fixtures/index.mjs",
    "./schema/gateway-envelope.v1.json": "./schema/gateway-envelope.v1.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "oxlint src",
    "schema:check": "bun scripts/schema.mjs --check",
    "schema:generate": "bun scripts/schema.mjs",
    "test": "bun scripts/schema.mjs --check && bun test src"
  },
  "dependencies": {
    "zod": "4.6.1"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
