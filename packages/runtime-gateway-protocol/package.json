{
  "name": "@control-plane/runtime-gateway-protocol",
  "version": "1.2.1",
  "license": "Apache-2.0",
  "files": [
    "dist",
    "fixtures",
    "schema"
  ],
  "type": "module",
  "browser": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "node": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./fixtures": "./fixtures/index.mjs",
    "./schema/gateway-envelope.v1.json": "./schema/gateway-envelope.v1.json"
  },
  "publishConfig": {
