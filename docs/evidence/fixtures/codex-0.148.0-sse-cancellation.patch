@@ -0,0 +1,28 @@
+use super::*;
+use bytes::Bytes;
+use codex_client::TransportError;
+
+#[tokio::test]
+async fn dropping_consumer_releases_a_silent_provider_stream() {
+    let (bytes_tx, bytes_rx) = mpsc::channel::<Result<Bytes, TransportError>>(1);
+    let stream = futures::stream::unfold(bytes_rx, |mut receiver| async move {
+        receiver.recv().await.map(|value| (value, receiver))
+    });
+    let (tx, rx) = mpsc::channel::<Result<ResponseEvent, ApiError>>(1);
+    let task = tokio::spawn(process_sse(
+        Box::pin(stream),
+        tx,
+        Duration::from_secs(60),
+        /*telemetry*/ None,
+    ));
+    tokio::task::yield_now().await;
+    assert!(!bytes_tx.is_closed());
+    drop(rx);
+    let released = timeout(Duration::from_secs(1), bytes_tx.closed()).await;
+    task.abort();
+    let _ = task.await;
+    assert!(
+        released.is_ok(),
+        "consumer cancellation retained the provider stream"
+    );
+}
