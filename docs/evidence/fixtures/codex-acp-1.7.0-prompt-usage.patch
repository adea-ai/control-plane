+    async captureResumeUsage<T>(threadId: string, operation: (read: () => TokenCount | null) => Promise<T>): Promise<T> {
+        if (this.usageCaptures.has(threadId)) throw new Error('RESUME_USAGE_CAPTURE_CONFLICT');
