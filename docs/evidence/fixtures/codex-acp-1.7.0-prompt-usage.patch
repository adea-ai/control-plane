diff --git a/src/TokenCount.ts b/src/TokenCount.ts
index 1f7cf0b..519b659 100644
--- a/src/TokenCount.ts
+++ b/src/TokenCount.ts
@@ -21,0 +22,34 @@ export interface TokenCount {
+export function zeroTokenCount(): TokenCount {
+    return { totalTokens: 0, inputTokens: 0, cachedInputTokens: 0, outputTokens: 0, reasoningOutputTokens: 0 };
+}
+
+/** A prompt is billable only with a known baseline and monotonic native totals. */
+export class PromptTokenUsage {
+    private readonly baseline: TokenCount | null;
+    private latest: TokenCount | null = null;
+    private invalid = false;
+
+    constructor(baseline: TokenCount | null) {
+        this.baseline = baseline === null ? null : { ...baseline };
+    }
+
+    observe(total: TokenCount): void {
+        const previous = this.latest ?? this.baseline;
+        for (const key of Object.keys(zeroTokenCount()) as (keyof TokenCount)[]) {
+            if (!Number.isSafeInteger(total[key]) || total[key] < 0 ||
+                (previous !== null && total[key] < previous[key])) this.invalid = true;
+        }
+        this.latest = { ...total };
+    }
+
+    usage(): Usage | null {
+        if (this.invalid || this.baseline === null || this.latest === null) return null;
+        const delta = zeroTokenCount();
+        for (const key of Object.keys(delta) as (keyof TokenCount)[]) {
+            if (!Number.isSafeInteger(this.baseline[key]) || this.baseline[key] < 0) return null;
+            delta[key] = this.latest[key] - this.baseline[key];
+        }
+        return toPromptUsage(delta);
+    }
+}
+
