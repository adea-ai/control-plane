+        const validity = new PromptTokenUsage(zeroTokenCount());
+        const captures = new Set([(usage: TokenCount) => {
+            validity.observe(usage);
+            latest = { ...usage };
+        }]);
+        this.usageCaptures.set(threadId, captures);
+        try {
+            return await operation(() => latest === null || validity.usage() === null ? null : { ...latest });
+        } finally {
+            if (this.usageCaptures.get(threadId) === captures) this.usageCaptures.delete(threadId);
+        }
