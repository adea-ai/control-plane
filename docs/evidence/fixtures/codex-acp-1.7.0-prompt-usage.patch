+++ b/src/resume-usage-probe.ts
@@ -0,0 +1,45 @@
+import assert from 'node:assert/strict';
+import { once } from 'node:events';
+import { startCodexConnection } from './CodexJsonRpcConnection';
+import { CodexAppServerClient } from './CodexAppServerClient';
+import { CodexAcpClient } from './CodexAcpClient';
+import { CodexAcpServer } from './CodexAcpServer';
+
+async function open() {
+    const transport = startCodexConnection('/tmp/acp/node_modules/.bin/codex');
+    const client = new CodexAppServerClient(transport.connection);
+    const events: unknown[] = [];
+    client.onClientTransportEvent(event => {
+        if (event.eventType === 'notification' && event.method === 'thread/tokenUsage/updated') events.push(event.params);
+    });
+    const connection = new Proxy({} as any, { get: () => async () => ({}) });
+    const agent = new CodexAcpServer(connection, new CodexAcpClient(client), undefined, () => transport.process.exitCode);
+    await agent.initialize({ protocolVersion: 1 });
+    await agent.authenticate({ methodId: 'gateway', _meta: { gateway: { baseUrl: 'http://127.0.0.1:8787/v1', headers: {}, providerName: 'isolated-fixture' } } } as any);
+    return { agent, events, async close() {
+        const closed = once(transport.process, 'close');
+        transport.connection.end();
+        transport.process.kill();
+        await closed;
+    } };
+}
+
+const first = await open();
+let sessionId: string;
+try {
+    ({ sessionId } = await first.agent.newSession({ cwd: '/tmp', mcpServers: [] }));
+    const result = await first.agent.prompt({ sessionId, prompt: [{ type: 'text', text: 'Say hello.' }] });
+    assert.equal(result.stopReason, 'end_turn');
+    assert.equal(result.usage?.inputTokens, 11);
+} finally { await first.close(); }
+
+const resumed = await open();
+try {
+    await resumed.agent.loadSession({ sessionId: sessionId!, cwd: '/tmp', mcpServers: [] });
+    const before = resumed.events.length;
+    const result = await resumed.agent.prompt({ sessionId: sessionId!, prompt: [{ type: 'text', text: 'Say hello again.' }] });
+    assert.equal(result.stopReason, 'end_turn');
+    assert.equal(result.usage?.inputTokens, 11, 'resumed prompt must exclude historical usage');
+    assert.equal(result.usage?.outputTokens, 3, 'resumed prompt must exclude historical usage');
+    console.log(JSON.stringify({ beforePromptUsageEvents: before, usageEvents: resumed.events, resumedPromptUsage: result.usage }));
+} finally { await resumed.close(); }
