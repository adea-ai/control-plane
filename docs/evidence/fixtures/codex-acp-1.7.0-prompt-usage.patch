@@ -0,0 +1,43 @@
+import { it, expect } from 'vitest';
+import { createCodexMockTestFixture } from './acp-test-utils';
+
+it('captures only the resumed thread and discards observations outside the operation', async () => {
+    const fixture = createCodexMockTestFixture();
+    const client = fixture.getCodexAppServerClient();
+    const emit = (threadId: string) => fixture.sendServerNotification({
+        method: 'thread/tokenUsage/updated',
+        params: { threadId, turnId: 'previous-turn', tokenUsage: {
+            total: { totalTokens: 14, inputTokens: 11, cachedInputTokens: 0, cacheWriteInputTokens: 0, outputTokens: 3, reasoningOutputTokens: 0 },
+            last: { totalTokens: 14, inputTokens: 11, cachedInputTokens: 0, cacheWriteInputTokens: 0, outputTokens: 3, reasoningOutputTokens: 0 },
+            modelContextWindow: 10000,
+        } },
+    });
+    emit('resumed');
+    await client.captureResumeUsage('resumed', async read => {
+        expect(read()).toBeNull();
+        emit('unrelated');
+        expect(read()).toBeNull();
+        emit('resumed');
+        expect(read()).toMatchObject({ inputTokens: 11, outputTokens: 3 });
+        const copy = read()!;
+        copy.inputTokens = 0;
+        expect(read()?.inputTokens).toBe(11);
+        await expect(client.captureResumeUsage('resumed', async () => null)).rejects.toThrow('RESUME_USAGE_CAPTURE_CONFLICT');
+    });
+    await expect(client.captureResumeUsage('resumed', async () => { throw new Error('probe'); })).rejects.toThrow('probe');
+    expect(await client.captureResumeUsage('resumed', async read => read())).toBeNull();
+});
+
+it('rejects a regressed resume baseline even if a later counter catches up', async () => {
+    const fixture = createCodexMockTestFixture();
+    await fixture.getCodexAppServerClient().captureResumeUsage('resumed', async read => {
+        for (const inputTokens of [11, 1, 22]) {
+            const count = { totalTokens: inputTokens + 3, inputTokens, cachedInputTokens: 0, cacheWriteInputTokens: 0, outputTokens: 3, reasoningOutputTokens: 0 };
+            fixture.sendServerNotification({ method: 'thread/tokenUsage/updated', params: {
+                threadId: 'resumed', turnId: 'previous-turn',
+                tokenUsage: { total: count, last: count, modelContextWindow: 10000 },
+            } });
+        }
+        expect(read()).toBeNull();
+    });
+});
