diff --git a/src/__tests__/prompt-token-usage.test.ts b/src/__tests__/prompt-token-usage.test.ts
new file mode 100644
index 0000000..8fdb94a
--- /dev/null
+++ b/src/__tests__/prompt-token-usage.test.ts
@@ -0,0 +1,44 @@
+import { describe, it, expect } from 'vitest';
+import { PromptTokenUsage, zeroTokenCount } from '../TokenCount';
+
+const count = (input: number, output: number) => ({
+    ...zeroTokenCount(), inputTokens: input, outputTokens: output, totalTokens: input + output,
+});
+
+describe('prompt-scoped native cumulative usage', () => {
+    it('subtracts prior prompts and ignores duplicate totals', () => {
+        const usage = new PromptTokenUsage(count(100, 20));
+        usage.observe(count(111, 23));
+        usage.observe(count(122, 26));
+        usage.observe(count(122, 26));
+        expect(usage.usage()).toMatchObject({ inputTokens: 22, outputTokens: 6, totalTokens: 28 });
+    });
+
+    it('does not invent a baseline for a loaded session', () => {
+        const usage = new PromptTokenUsage(null);
+        usage.observe(count(111, 23));
+        expect(usage.usage()).toBeNull();
+    });
+
+    it('does not invent zero usage when there was no native observation', () => {
+        expect(new PromptTokenUsage(zeroTokenCount()).usage()).toBeNull();
+    });
+
+    it('keeps a counter regression invalid even after counters catch up', () => {
+        const usage = new PromptTokenUsage(count(100, 20));
+        usage.observe(count(111, 23));
+        usage.observe(count(11, 3));
+        usage.observe(count(122, 26));
+        expect(usage.usage()).toBeNull();
+    });
+
+    it('snapshots caller-owned baselines and observations', () => {
+        const baseline = count(100, 20);
+        const usage = new PromptTokenUsage(baseline);
+        baseline.inputTokens = 0;
+        const observed = count(111, 23);
+        usage.observe(observed);
+        observed.inputTokens = 0;
+        expect(usage.usage()).toMatchObject({ inputTokens: 11, outputTokens: 3 });
+    });
+});
