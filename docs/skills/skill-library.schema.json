{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/adea-ai/control-plane/docs/skills/skill-library.schema.json",
  "title": "Control Plane Skill library manifest",
  "description": "Machine-readable inventory of the repository's retained audit skills. Generated by `bun scripts/validate-skills.mjs --refresh` and verified by the same script without `--refresh`.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "skills"],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1,
      "description": "Manifest schema version. Bump on any breaking change to the skill record shape."
    },
    "skills": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/skill" }
    }
  },
  "$defs": {
    "semanticVersion": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-((?:0|[1-9]\\d*|\\d*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?$"
    },
    "skill": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "description",
        "version",
        "owner",
        "trigger",
        "nontrigger",
        "boundaries",
        "stopConditions",
        "cleanup",
        "deprecated",
        "provenance",
        "files",
        "skillMdBytes",
        "skillMdDigest"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "description": "Skill identity; equals the directory name and the frontmatter name."
        },
        "description": {
          "type": "string",
          "minLength": 10,
          "maxLength": 400,
          "pattern": "^Use when .+?\\. Not for .+?\\.",
          "description": "Agent-visible routing surface. Must follow 'Use when <trigger>. Not for <non-trigger>.'"
        },
        "version": {
          "$ref": "#/$defs/semanticVersion",
          "description": "Skill version. For vendored skills this is the pinned upstream version."
        },
        "owner": {
          "type": "string",
          "minLength": 1,
          "description": "Accountable owner. Matches the frontmatter metadata.owner exactly."
        },
        "trigger": {
          "type": "string",
          "minLength": 20,
          "description": "Unique trigger clause. Must not overlap any other skill's routing clause."
        },
        "nontrigger": {
          "type": "string",
          "minLength": 20,
          "description": "Unique non-trigger clause. Must not overlap any other skill's routing clause."
        },
        "boundaries": {
          "type": "object",
          "additionalProperties": false,
          "required": ["Secrets", "Dirty worktree", "Migration", "Generated files", "Provider"],
          "description": "Per-skill safety boundaries. Each labelled value must be unique across the library.",
          "properties": {
            "Secrets": { "type": "string", "minLength": 30 },
            "Dirty worktree": { "type": "string", "minLength": 30 },
            "Migration": { "type": "string", "minLength": 30 },
            "Generated files": { "type": "string", "minLength": 30 },
            "Provider": { "type": "string", "minLength": 30 }
          }
        },
        "stopConditions": {
          "type": "string",
          "minLength": 30,
          "description": "When the skill halts and hands back. Required evidence-contract field '**Stop conditions:**'."
        },
        "cleanup": {
          "type": "string",
          "minLength": 10,
          "description": "Cleanup contract. Required evidence-contract field '**Cleanup:**'."
        },
        "deprecated": {
          "type": "boolean",
          "description": "True when the skill is deprecated and still retained for one release."
        },
        "supersededBy": {
          "type": "string",
          "minLength": 1,
          "description": "Required when deprecated: the skill that replaces it."
        },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["origin"],
          "properties": {
            "origin": {
              "type": "string",
              "enum": ["repository-owned", "vendored-upstream"]
            },
            "source": {
              "type": "string",
              "minLength": 1,
              "description": "Required for vendored-upstream skills; names the upstream origin."
            },
            "upstreamVersion": {
              "$ref": "#/$defs/semanticVersion",
              "description": "Required for vendored-upstream skills; equals the pinned version."
            },
            "integrationVersion": {
              "$ref": "#/$defs/semanticVersion",
              "description": "Local integration revision of a vendored skill."
            }
          },
          "if": {
            "properties": { "origin": { "const": "vendored-upstream" } },
            "required": ["origin"]
          },
          "then": { "required": ["source", "upstreamVersion"] },
          "else": { "not": { "required": ["source"] } }
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" },
          "description": "Repository-owned files bundled with the skill."
        },
        "skillMdBytes": {
          "type": "integer",
          "minimum": 1,
          "description": "Byte size of the skill entrypoint."
        },
        "skillMdDigest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$",
          "description": "SHA-256 digest of the skill entrypoint bytes."
        }
      },
      "if": {
        "properties": { "deprecated": { "const": true } },
        "required": ["deprecated"]
      },
      "then": { "required": ["supersededBy"] }
    }
  }
}
