APP_ENV=development
SERVICE_VERSION=0.0.0-development
COMMIT_SHA=local
INSTANCE_ID=runtime-gateway-local
RUNTIME_GATEWAY_PORT=3001
# Hosted/server PostgreSQL composition (enable only with real host adapters).
# DATABASE_URL must use the restricted application role. Never put an issuer
# private key in this environment; only operator public-key trust belongs here.
# DATABASE_URL_UNPOOLED is the direct application-role URL for revocation LISTEN.
# Required when DATABASE_URL uses a Neon -pooler endpoint; never use a migration
# or administration principal here. Generic transaction poolers also need a direct URL.
# DATABASE_URL_UNPOOLED=postgresql://<application-role>:<password>@<direct-host>/<database>
# RUNTIME_GATEWAY_STORE_BACKEND=postgres
# RUNTIME_GATEWAY_INSTANCE_ID=runtime-gateway-local
# RUNTIME_GATEWAY_HOST=0.0.0.0
# RUNTIME_NODE_IDENTITY_ISSUER=https://identity.example.invalid/runtime-nodes
# RUNTIME_NODE_IDENTITY_AUDIENCE=control-plane-runtime-gateway
# RUNTIME_NODE_IDENTITY_ISSUER_PUBLIC_KEYS_JSON='{"operator-key-01":"-----BEGIN PUBLIC KEY-----\\n<replace-with-ed25519-public-key>\\n-----END PUBLIC KEY-----\\n"}'
