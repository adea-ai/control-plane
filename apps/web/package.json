{
  "name": "@adea-ai/web",
  "version": "0.87.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun run cf-typegen && bun ../../scripts/sync-assets.mjs && vite build && bun run start:check-ui-sources",
    "build:cloudflare": "bun run --cwd ../.. build:cloudflare",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "deploy": "bun run build:cloudflare && cf-wrangler build && cf deploy --prebuilt",
    "desktop:build": "bun ../../scripts/sync-assets.mjs && vite build --config vite.desktop.config.ts && bun run start:check-ui-sources --desktop",
    "dev": "bun ../../scripts/sync-assets.mjs && vite",
    "lint": "oxlint",
    "preview": "bun run build && bun x wrangler dev --local",
    "start:accept:allowlist": "node start/acceptance-allowlist.mjs",
    "start:accept:gates": "node start/acceptance-gates.mjs",
    "start:accept:hosted": "node start/acceptance-hosted.mjs",
    "start:accept:sign-in": "node start/acceptance-sign-in.mjs",
    "start:check-bundle": "node start/check-client.mjs",
    "start:check-ui-sources": "node start/check-ui-tailwind-sources.mjs",
    "start:check-routes": "node start/check-routes.mjs",
    "start:compare": "node start/compare-hosts.mjs",
    "start:e2e": "playwright test --config start/playwright.config.ts",
    "start:test": "bun test test/start-host.test.ts",
    "start:test:local": "node start/test-local.mjs",
    "start:verify": "bun run start:test && bun run build && bun run typecheck && bun run start:check-bundle",
    "test": "bun test --conditions=browser test/*.test.ts start/ui-tailwind-sources.test.ts",
    "typecheck": "bun run cf-typegen && tsc --noEmit",
    "upload": "cf previews deploy"
  },
  "dependencies": {
    "@adea-ai/api-client": "workspace:*",
    "@adea-ai/app-core": "workspace:*",
    "@adea-ai/app-ui": "workspace:*",
    "@adea-ai/audio": "workspace:*",
    "@adea-ai/auth": "workspace:*",
    "@adea-ai/contracts": "1.19.1",
    "@adea-ai/data": "workspace:*",
    "@adea-ai/db": "workspace:*",
    "@adea-ai/dev-view": "workspace:*",
    "@adea-ai/sdk": "1.17.0",
    "@adea-ai/spatial": "workspace:*",
    "@adea-ai/state": "workspace:*",
    "@adea-ai/types": "workspace:*",
    "@adea-ai/ui": "0.122.3",
    "@adea-ai/workspace-nav": "workspace:*",
    "@adea-ai/workspace-ui": "workspace:*",
    "@neondatabase/auth": "0.5.0-beta",
    "@tanstack/solid-query": "^5.104.1",
    "@tanstack/solid-router": "1.170.38",
    "@tanstack/solid-start": "1.168.57",
    "lucide-solid": "^1.51.0",
    "server-only": "^0.0.1",
    "solid-js": "^1.9.15"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.62.5",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/three": "0.186.0",
    "cf": "^1.0.0-beta.12",
    "drizzle-orm": "^0.45.3",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript6": "npm:typescript@^6.0.3",
    "vite": "^8.3.2",
    "vite-plugin-solid": "^2.11.14",
    "wrangler": "^4.147.0"
  }
}
