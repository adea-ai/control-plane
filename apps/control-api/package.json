{
  "name": "@control-plane/control-api",
  "version": "1.20.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "browser": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "bun src/start.ts",
    "dev": "bun --watch src/start.ts",
    "lint": "oxlint src",
    "openapi:check": "bun src/openapi/check.ts",
    "test": "bun test src --timeout 30000",
    "test:integration": "bun test src/validation-replay.integration.test.mjs src/budget-admission.integration.test.mjs src/marketplace-installation.integration.test.mjs --timeout 30000"
  },
  "dependencies": {
    "@control-plane/bootstrap": "workspace:*",
    "@control-plane/config": "workspace:*",
    "@control-plane/context": "workspace:*",
    "@control-plane/contracts": "workspace:*",
    "@control-plane/credential-vault": "workspace:*",
    "@control-plane/database": "workspace:*",
    "@control-plane/deployment": "workspace:*",
    "@control-plane/domain": "workspace:*",
    "@control-plane/execution-plan": "workspace:*",
    "@control-plane/memory-writeback": "workspace:*",
    "@control-plane/model-gateway": "workspace:*",
    "@control-plane/orchestration": "workspace:*",
    "@control-plane/telemetry": "workspace:*",
    "@control-plane/usage-ledger": "workspace:*",
    "@fastify/helmet": "13.1.1",
    "@nestjs/common": "12.1.2",
    "@nestjs/core": "12.1.2",
    "@nestjs/platform-fastify": "12.1.2",
    "@nestjs/swagger": "12.0.2",
    "@opentelemetry/api": "1.9.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "drizzle-orm": "0.45.3",
    "fastify": "5.12.5",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@control-plane/sqlite-persistence": "workspace:*",
    "@control-plane/testing": "workspace:*"
  },
  "engines": {
    "node": "24.21.0"
  }
}
