    "@control-plane/object-store": "workspace:*",
    "@control-plane/orchestration": "workspace:*",
    "@control-plane/remote-control-relay": "workspace:*",
    "@control-plane/restate-runtime": "workspace:*",
    "@control-plane/secrets": "workspace:*",
